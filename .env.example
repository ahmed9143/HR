# =============================================================================
# HR Enterprise v17 — production configuration contract
#
# Copy to `.env` (or set these as real environment variables / Windows service
# variables). Secrets must NOT be committed and must NOT be typed into the UI.
# =============================================================================

# --- Deployment mode ---------------------------------------------------------
# auto      : discover an existing LAN server, otherwise elect one (default)
# standalone: single machine, loopback only
# network   : dedicated server for other machines on the LAN
HR_MODE=standalone

# 127.0.0.1 stays plain HTTP. Binding anything else (e.g. 0.0.0.0 for the
# Network Server) auto-generates a self-signed certificate and serves HTTPS
# if HR_TLS_CERT is not set — see --- TLS --- below.
HR_HOST=127.0.0.1
HR_PORT=8899
HR_PORT_MAX=8920

# --- First-run bootstrap -----------------------------------------------------
# If set (min 12 chars), this becomes the initial `admin` password.
# If NOT set, a cryptographically random password is generated on first run and
# written to data/INITIAL_ADMIN_PASSWORD.txt (mode 0600). Either way the account
# is created with must_change_password=1, and the file is deleted automatically
# once the password is rotated.
# HR_BOOTSTRAP_PASSWORD=

# --- TLS ---------------------------------------------------------------------
# Set both to use your own real certificate instead of the auto-generated one.
# Setting only https_enabled in the UI emits an HSTS header over plaintext —
# it does NOT encrypt anything on its own.
# HR_TLS_CERT=C:\hr\certs\server.pem
# HR_TLS_KEY=C:\hr\certs\server.key
#
# If neither is set AND the server is bound to a non-loopback host (e.g. the
# Network Server's default 0.0.0.0), it auto-generates a self-signed
# certificate on first run (data/auto_tls_cert.pem) and serves real HTTPS
# with it, so it is never forced to choose between refusing to start and
# serving payroll/national-ID data in plaintext. Browsers show a one-time
# "not trusted" warning per device for this internal certificate; that is
# expected.
#
# HR_NO_AUTO_TLS=1     # opt out of the auto-generated certificate above and
                        # restore the strict original behaviour: refuse to
                        # start on a non-loopback host unless a real
                        # certificate or HR_ALLOW_PLAINTEXT_LAN=1 is set.
#
# Escape hatch: allow plaintext on a non-loopback interface. Only correct when
# an HTTPS reverse proxy terminates in front, or on a physically isolated VLAN.
# HR_ALLOW_PLAINTEXT_LAN=0

# --- Backups -----------------------------------------------------------------
# 32-byte key, base64 or 64 hex chars. If unset, data/backup.key is generated
# once — COPY IT OFFLINE. Without the key no encrypted backup can be restored.
# HR_BACKUP_KEY=
#
# Set to 1 to write UNENCRYPTED backups. Do not use in production.
HR_BACKUP_PLAINTEXT=0

# --- Authentication hardening ------------------------------------------------
HR_AUTH_MAX_FAILS=5          # failures before a lockout
HR_AUTH_LOCK_SECS=300        # first lockout; doubles on each repeat
HR_AUTH_MAX_LOCK_SECS=86400  # ceiling (24h)
HR_AUTH_WINDOW_SECS=900      # failure counting window

# --- HTTP limits -------------------------------------------------------------
HR_MAX_BODY=2097152          # 2 MB   ordinary form POSTs
HR_MAX_UPLOAD=67108864       # 64 MB  document / photo uploads
HR_MAX_IMPORT=268435456      # 256 MB bulk folder / Excel import
HR_MAX_WORKERS=48            # concurrent requests; excess gets 503
HR_SOCKET_TIMEOUT=120        # seconds
HR_SLOW_REQUEST_SECS=3.0     # threshold counted in /health/deep

# --- Retention (days; 0 disables that table) ---------------------------------
HR_RETAIN_AUDIT=730          # never trimmed below 365 regardless of this value
HR_RETAIN_ERRORS=90
HR_RETAIN_LOGINS=365
HR_RETAIN_SESSIONS=90
HR_RETAIN_DEVICE=90
HR_RETAIN_NOTIFS=180
HR_SESSION_IDLE_DAYS=7

# --- Database ----------------------------------------------------------------
# SQLite is the supported production store. PostgreSQL support exists in the
# tree but is NOT validated end-to-end — see docs/POSTGRES_STATUS.md.
# HR_DB_URL=

# --- Misc --------------------------------------------------------------------
HR_NO_BROWSER=0
# HR_COOKIE_SECURE=1         # force Secure cookie when TLS terminates upstream
